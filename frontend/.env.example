# Copy to .env.local and fill in. .env.local is gitignored.
# Secrets must NOT be prefixed NEXT_PUBLIC_ (that bundles them to the browser).

# ── Public (safe to ship to the browser) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL used to build links in outbound email (must NOT be
# derived from request headers — those are spoofable). Prod = live domain.
NEXT_PUBLIC_SITE_URL=https://www.imperialentrepreneurs.com

# ── Server-only secrets ──
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM=Foundry <contact@imperialentrepreneurs.com>
CONTACT_INBOX_EMAIL=contact@imperialentrepreneurs.com
APPEALS_EMAIL=appeals@imperialentrepreneurs.com
# Where a new content report lands. Falls back to CONTACT_INBOX_EMAIL, so a
# report always reaches somebody monitored even if this is never set.
MODERATION_INBOX_EMAIL=
CRON_SECRET=

# ── Rate limiting (Upstash) — optional; rate limiting is a no-op if unset ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Response cache (Upstash) — optional; caching is a no-op if unset ──
# Falls back to the rate-limiting database above when these are blank, which
# works but makes the two share one command quota. The `submit` rate-limit
# bucket fails CLOSED, so cache traffic exhausting that quota would start
# refusing submissions. Point these at a SEPARATE Upstash database once the
# plan allows one — the free tier is a single database and 500K commands a
# month, so splitting means pay-as-you-go. Region matters: vercel.json pins
# fra1 and the cache read has a 100ms deadline, so a database outside
# eu-central-1 times out on every read and silently degrades to Supabase.
# The app logs a warning at boot while they are sharing.
UPSTASH_CACHE_REDIS_REST_URL=
UPSTASH_CACHE_REDIS_REST_TOKEN=

# ── Cloudflare Turnstile — optional; widget/verify skipped if unset ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Observability — optional; inert if unset ──
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Build-time only (not shipped to the browser). Lets `next build` upload
# source maps to Sentry so production stack traces show real source instead
# of minified bundles. Set these in Vercel's project env, not .env.local —
# they're only read during the Vercel build, never in CI. Skipped silently
# if SENTRY_AUTH_TOKEN is unset.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Community posts: image upload ───────────────────────────────────
# All optional. With UPLOAD_GATEWAY_URL or UPLOAD_TICKET_SECRET unset, the
# composer hides the image control entirely rather than offering a button
# that cannot work — so text posting runs fine without any of this, which is
# what lets the feature ship before the Azure side exists.
UPLOAD_GATEWAY_URL=
UPLOAD_TICKET_SECRET=
GATEWAY_SERVICE_TOKEN=

# Read-only service principal. Used only to fetch a user-delegation key and
# sign short-lived image URLs; it cannot write or delete, so a compromise of
# this environment cannot destroy or replace a member's image.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STORAGE_ACCOUNT=
AZURE_BLOB_CONTAINER=post-images

# ─── GitHub connect: optional CV-matchmaker signal ───────────────────
# A standalone GitHub OAuth App (github.com Settings → Developer settings →
# OAuth Apps), NOT Supabase Auth's GitHub provider — see
# mediaActions.ts's requestGithubConnectUrl for why. Register one OAuth App
# per environment (GitHub only allows one callback URL each): callback URL
# is <site>/auth/github-connect/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Shared with the worker (server/.env.gateway.local's identically-named
# var) — encrypts/decrypts github_connections.access_token_encrypted via
# pgcrypto. Any long random string; never persisted in the database.
GITHUB_TOKEN_ENCRYPTION_KEY=
