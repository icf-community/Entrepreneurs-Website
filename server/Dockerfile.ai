# Foundry AI executor — production image (AI-plan §10, §10.1).
#
# Slim and separate from the gateway/worker image: only the executor's
# dependencies (requirements-ai.txt), no Azure storage, GitHub or document
# libraries, no storage or GitHub credentials. It has no ingress: it claims
# turns from Postgres as ai_service and calls only OpenAI and the database.
FROM python:3.12-slim-trixie

WORKDIR /app

RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-ai.txt ./
RUN pip install --no-cache-dir -r requirements-ai.txt

COPY app ./app

RUN useradd --system --no-create-home --shell /usr/sbin/nologin executor
USER executor

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

ARG GIT_SHA=""
ENV SENTRY_RELEASE=$GIT_SHA

# No HTTP port. Liveness is the Sentry cron monitor `ai-executor` and the
# `ai_queue_age` health check; a dead process stops checking in.
CMD ["python", "-m", "app.ai"]
